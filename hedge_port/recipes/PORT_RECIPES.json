{
  "schema_version": "freqtrade-hedge-port-recipes-v1",
  "upstream_version": "Freqtrade 2026.8-dev",
  "source_hedge_version": "N7K2-R2.3.0",
  "principle": "Preserve upstream; modular copy for Hedge-owned files; fail-closed semantic rebase for shared files.",
  "shared_files": [
    {
      "path": "freqtrade/commands/__init__.py",
      "mode": "STABLE_HOOK",
      "purpose": "Lazy exports for Hedge command entry points",
      "anchors": [
        "def __getattr__",
        "start_hedge_db"
      ]
    },
    {
      "path": "freqtrade/commands/arguments.py",
      "mode": "STABLE_HOOK",
      "purpose": "Register hedge-paper, hedge-backtesting, hedge-db and hedge-readonly-check via hedge_cli",
      "anchors": [
        "def _build_subcommands",
        "register_hedge_subcommands",
        "hedge-readonly-check"
      ]
    },
    {
      "path": "freqtrade/config_schema/config_schema.py",
      "mode": "STABLE_HOOK",
      "purpose": "Extend upstream schema through config_schema_extension",
      "anchors": [
        "CONF_SCHEMA",
        "extend_config_schema(CONF_SCHEMA)"
      ]
    },
    {
      "path": "freqtrade/configuration/config_validation.py",
      "mode": "MODULE_WRAPPER",
      "purpose": "Normalize before and validate after upstream consistency checks",
      "anchors": [
        "validate_config_consistency",
        "_upstream_validate_config_consistency"
      ]
    },
    {
      "path": "freqtrade/enums/__init__.py",
      "mode": "STABLE_EXPORT",
      "purpose": "Export PositionAction, PositionMode and PositionSide",
      "anchors": [
        "from freqtrade.enums.hedge import"
      ]
    },
    {
      "path": "freqtrade/freqtradebot.py",
      "mode": "THREE_WAY_REQUIRED",
      "purpose": "Single runtime composition, lifecycle split and native exchange-write barrier",
      "anchors": [
        "hedge_runtime",
        "_run_common_market_strategy_lifecycle",
        "assert_native_exchange_write_allowed"
      ]
    },
    {
      "path": "freqtrade/persistence/migrations.py",
      "mode": "SEMANTIC_SQL_REBASE",
      "purpose": "Preserve additive Hedge compatibility columns in native copy migrations; exclude H3 from native hook",
      "anchors": [
        "migrate_hedge_position_columns",
        "coalesce(position_side, 'BOTH')",
        "open_slot_key, hedge_version"
      ]
    },
    {
      "path": "freqtrade/persistence/trade_model.py",
      "mode": "THREE_WAY_REQUIRED",
      "purpose": "Side-aware isolated Trade/Order identity without polluting ordinary Freqtrade JSON",
      "anchors": [
        "is_explicit_hedge_trade",
        "refresh_hedge_identity",
        "position_side"
      ]
    },
    {
      "path": "freqtrade/rpc/api_server/webserver.py",
      "mode": "STABLE_HOOK",
      "purpose": "Register optional Hedge API plugin before UI catch-all router",
      "anchors": [
        "register_hedge_api_routes(app, config, self)",
        "# UI Router MUST be last!"
      ]
    },
    {
      "path": "freqtrade/rpc/external_message_consumer.py",
      "mode": "STABLE_HELPER",
      "purpose": "Fail-fast validated producer WebSocket URL",
      "anchors": [
        "def _producer_ws_url",
        "ws_url = _producer_ws_url(producer)"
      ]
    },
    {
      "path": "freqtrade/rpc/rpc.py",
      "mode": "TARGETED_GUARDS",
      "purpose": "Block native RPC writes while Hedge owns execution",
      "anchors": [
        "def _assert_native_exchange_write_allowed",
        "RPC_FORCE_EXIT",
        "RPC_FORCE_ENTRY"
      ]
    },
    {
      "path": "freqtrade/wallets.py",
      "mode": "THREE_WAY_REQUIRED",
      "purpose": "Independent LONG/SHORT wallet index while preserving 2026.8 account-equity uPnL correction",
      "anchors": [
        "get_all_positions_by_side",
        "unrealized_pnl",
        "_strip_unrealized_pnl",
        "position_wallet_key"
      ]
    }
  ],
  "future_upgrade_policy": {
    "auto_copy": [
      "freqtrade/hedge/**",
      "tests/hedge/**",
      "Hedge-owned commands/persistence/API helper modules",
      "docs/config/scripts/tools"
    ],
    "never_wholesale_copy": [
      "pyproject.toml",
      "requirements*.txt",
      "freqtrade/exchange/binance.py",
      "all upstream shared core files not in shared_files"
    ],
    "stop_conditions": [
      "shared anchor missing",
      "shared base hash changed",
      "ordinary Freqtrade behavior regression",
      "Hedge test failure",
      "upstream test failure"
    ]
  },
  "release_features": {
    "readonly_preflight_command": "hedge-readonly-check",
    "explicit_proxy_fields": [
      "hedge.rest_proxy_url",
      "hedge.websocket_proxy_url",
      "hedge.trust_env_proxy"
    ],
    "write_boundary": "LOCKED"
  }
}
